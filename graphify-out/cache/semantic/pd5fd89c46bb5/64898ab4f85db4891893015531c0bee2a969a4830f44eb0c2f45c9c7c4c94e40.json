{"nodes": [{"id": "nextjs_setup_nextjs_dashboard__agents_skills_prisma_mongodb_upgrade_references_schema_contract_mapping_v6_to_next_contract_mapping", "label": "v6 MongoDB to Prisma Next Contract Mapping", "file_type": "concept", "source_file": "nextjs-setup/nextjs-dashboard/.agents/skills/prisma-mongodb-upgrade/references/schema-contract-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma Next does not consume v6 schema.prisma as-is; translating mechanically without the mapping produces contracts that fail verification or silently change collection addressing."}, {"id": "nextjs_setup_nextjs_dashboard__agents_skills_prisma_mongodb_upgrade_references_schema_contract_mapping_collection_storage_addressing", "label": "Collection Storage Name Addressing", "file_type": "concept", "source_file": "nextjs-setup/nextjs-dashboard/.agents/skills/prisma-mongodb-upgrade/references/schema-contract-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most common porting mistake: v6 model names address the client (prisma.user), but Next Mongo ORM keys are collection storage names \u2014 the @@map name or lowercased model name (db.orm.users)."}, {"id": "nextjs_setup_nextjs_dashboard__agents_skills_prisma_mongodb_upgrade_references_schema_contract_mapping_mongodb_8_server_floor", "label": "MongoDB 8.0+ Server Floor", "file_type": "concept", "source_file": "nextjs-setup/nextjs-dashboard/.agents/skills/prisma-mongodb-upgrade/references/schema-contract-mapping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma Next's Mongo target requires MongoDB 8.0+ and mongodb@^7 peer dependency, while v6 tolerated older servers \u2014 check the server version before planning a migration."}], "edges": [{"source": "nextjs_setup_nextjs_dashboard__agents_skills_prisma