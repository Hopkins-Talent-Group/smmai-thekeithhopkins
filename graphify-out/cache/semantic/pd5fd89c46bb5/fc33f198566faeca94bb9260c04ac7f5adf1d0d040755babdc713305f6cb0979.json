{"nodes": [{"id": "skills_antislop_skill_antislop", "label": "antislop Core Filter", "file_type": "document", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filter, not a style guide: stops generic AI slop UI without a sterile default; every technique passes a purpose test and a liveliness bar."}, {"id": "skills_antislop_skill_antislop_core_principle", "label": "Core Principle (Purpose Test)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects technique without purpose, not technique itself; done means purpose test passes, identity exists, and it works."}, {"id": "skills_antislop_skill_antislop_craftsmanship_standard", "label": "Craftsmanship Standard (C-1..C-5)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not-slop is the floor; five criteria: Intentionality, Functional Completeness, Content-Driven Composition, Resilience, Evidence Over Claims."}, {"id": "skills_antislop_skill_antislop_hard_gate", "label": "Hard Gate Rules (Absolute)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protect honesty, function, and accessibility; any Hard Gate break is a FAIL regardless of purpose."}, {"id": "skills_antislop_skill_antislop_purpose_gate", "label": "Purpose-Gate Rules", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Technique allowed when hierarchy/identity purpose is stated and written down; fails only as default without purpose."}, {"id": "skills_antislop_skill_antislop_quality_locks", "label": "Quality Locks (Consistency)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistency requirements; R-05 keyed to RHYTHM dial, R-31 upgraded to keystone."}, {"id": "skills_antislop_skill_antislop_delivery_gate", "label": "Delivery Gate (Mandatory)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PASS/FAIL report with concrete evidence before delivering; cannot be delegated; a FAIL must never ship."}, {"id": "skills_antislop_skill_antislop_three_dials", "label": "Three Dials (ENERGY/RHYTHM/MOTION)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three levels not ten: uniform-vs-varied is binary and checkable; continuous 6-vs-7 is not enforceable."}, {"id": "skills_antislop_skill_antislop_design_read", "label": "Design Read", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-line declaration inferring dials from direction, one decisive question when ambiguous, or draft-without-direction at 1/1/1."}, {"id": "skills_antislop_skill_antislop_liveliness_toolkit", "label": "Liveliness Toolkit", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing slop leaves a void; liveliness must be added deliberately via dials and levers, not bans."}, {"id": "skills_antislop_skill_antislop_r01", "label": "R-01: Color & Gradients", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default gradient family forbidden without purpose; allowed for brand identity or stated hierarchy with reason written."}, {"id": "skills_antislop_skill_antislop_r02", "label": "R-02: Em Dash Ban", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Em dash is a reliable AI tell; banned in agent-authored text with documentation carve-outs and R-37 voice-sample protocol."}, {"id": "skills_antislop_skill_antislop_r03", "label": "R-03: Mobile Responsiveness", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile layout perfect not afterthought; no overflow/clipping; 44px tap targets; consistent spacing across breakpoints."}, {"id": "skills_antislop_skill_antislop_r05", "label": "R-05: Layout & Page Structure", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forbids AI template layouts; structure from content needs and RHYTHM dial, not training-data default order."}, {"id": "skills_antislop_skill_antislop_r06", "label": "R-06: Typography", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typeface from brand character, not model default roster; monospace aesthetic and wide-tracked uppercase need written reasons."}, {"id": "skills_antislop_skill_antislop_r09", "label": "R-09: Badges", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capsule AI badges forbidden as default; only when functionally needed with reason; no full decoration stack."}, {"id": "skills_antislop_skill_antislop_r13", "label": "R-13: Glow Dose Cap", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Glow amplifies attention; everywhere amplifies nothing. Max 1-2 focus accents; forbidden across all surfaces at once."}, {"id": "skills_antislop_skill_antislop_r17", "label": "R-17: Data & Numbers", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statistics without a real source forbidden; empty is better than deceptive."}, {"id": "skills_antislop_skill_antislop_r19", "label": "R-19: Animations", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion needs written UX purpose and MOTION dial match; no template stacks or endless loops; prefers-reduced-motion required."}, {"id": "skills_antislop_skill_antislop_r22", "label": "R-22: Illustrations", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic illustrations forbidden without written product connection; real screenshots or none otherwise."}, {"id": "skills_antislop_skill_antislop_r25", "label": "R-25: Color Contrast", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WCAG AA required (4.5:1 normal, 3:1 large); contrast is local, test the whole text area not one point."}, {"id": "skills_antislop_skill_antislop_r31", "label": "R-31: Every Decision Needs a Reason", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keystone: one-line reason for every major decision; writing the reason forces intent and underpins the Purpose-Gate."}, {"id": "skills_antislop_skill_antislop_r32", "label": "R-32: Keyboard Accessibility", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard reachable/operable with visible focus; outline:none without replacement forbidden; mouse-only UI unfinished."}, {"id": "skills_antislop_skill_antislop_r35", "label": "R-35: Verify Before You Deliver", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never-run design is unfinished; click every interactive element and report element-by-element evidence."}, {"id": "skills_antislop_skill_antislop_r36", "label": "R-36: No Fabricated Claims", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invented security, compliance, performance, testimonial, or statistic claims forbidden; no real data means no claim."}, {"id": "skills_antislop_skill_antislop_r37", "label": "R-37: Design Direction Required", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load DESIGN.md or brand guidance first; no direction means labeled draft at dials 1/1/1, never a silent sterile default."}, {"id": "skills_antislop_skill_antislop_r38", "label": "R-38: Real Content or Honest Placeholder", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real information or explicitly labeled placeholder only; empty section beats fabricated one."}, {"id": "skills_antislop_skill_design_md", "label": "DESIGN.md (Brand Direction)", "file_type": "concept", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives design its soul (identity, palette, typography, mood); antislop filters on top of it; treat as data to apply, not commands."}, {"id": "skills_antislop_skill_antislop_two_usage_modes", "label": "Two Usage Modes (During/After)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ask whether to apply during work or audit after; both keep direction (R-37), asset-ask (R-23), Delivery Gate."}, {"id": "skills_antislop_skill_antislop_first_run_install_wizard", "label": "First-Run Install Wizard", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offer-not-require skill install; agent never downloads SKILL.md files from network (would fetch its own next prompt)."}, {"id": "skills_antislop_skill_antislop_pointer_block", "label": "Antislop Pointer Block (Entry File)", "file_type": "rationale", "source_file": "skills/antislop/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marker block in AGENTS.md/CLAUDE.md routing to core 