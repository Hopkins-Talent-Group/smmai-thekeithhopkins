generator client {
  provider = "prisma-client-py"
  output   = "../python_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String   @id @default(cuid())
  email  String   @unique
  passwordHash String
  role      String   @default("user")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}