# ==========================================
# Public (safe to expose)
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Server-only — DO NOT commit real values
# ==========================================

# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Auth
SESSION_SECRET=generate-with-openssl-rand-base64-32
JWT_SECRET=generate-with-openssl-rand-base64-32

# AI provider
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Queue
REDIS_URL=redis://your-redis-host:6379

# Application
DRY_RUN=true

# Security
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
OAUTH_STATE_SECRET=<base64-encoded-32-byte-key-used-to-sign-oauth-state>
META_APP_SECRET=<Meta app secret used for webhook signatures>
META_VERIFY_TOKEN=<Meta webhook verification token>
LINKEDIN_CLIENT_ID=<LinkedIn OAuth client id>
LINKEDIN_CLIENT_SECRET=<LinkedIn OAuth client secret>
LINKEDIN_SCOPES=<space-separated LinkedIn scopes, default: openid profile w_member_social>
LINKEDIN_WEBHOOK_SECRET=<LinkedIn webhook HMAC secret>
LINKEDIN_VERIFY_TOKEN=<LinkedIn webhook verification token fallback>
X_CLIENT_ID=<X OAuth client id>
X_CLIENT_SECRET=<X OAuth client secret>
X_SCOPES=<space-separated X scopes, default: tweet.read tweet.write users.read offline.access>
X_WEBHOOK_SECRET=<X webhook HMAC secret>
X_VERIFY_TOKEN=<X webhook verification token fallback>
REDIS_URL=<redis connection URL>
